
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppJogoDaVelha.MainPage">

    <!-- FUNDO DEGRADE NEON -->
    <ContentPage.Background>
        <LinearGradientBrush
            StartPoint="0,0"
            EndPoint="1,1">

            <GradientStop
                Color="#091123"
                Offset="0.0" />

            <GradientStop
                Color="#172D50"
                Offset="0.55" />

            <GradientStop
                Color="#241B48"
                Offset="1.0" />

        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- ESTILOS PERSONALIZADOS -->
    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- ESTILO DAS CASAS -->
            <Style
                x:Key="CasaStyle"
                TargetType="Button">

                <Setter
                    Property="BackgroundColor"
                    Value="#203453" />

                <Setter
                    Property="TextColor"
                    Value="#65E4EF" />

                <Setter
                    Property="FontSize"
                    Value="48" />

                <Setter
                    Property="FontAttributes"
                    Value="Bold" />

                <Setter
                    Property="CornerRadius"
                    Value="16" />

                <Setter
                    Property="BorderColor"
                    Value="#405A80" />

                <Setter
                    Property="BorderWidth"
                    Value="1" />

                <Setter
                    Property="Padding"
                    Value="0" />

            </Style>

            <!-- ESTILO DO BOTAO REINICIAR -->
            <Style
                x:Key="AcaoStyle"
                TargetType="Button">

                <Setter
                    Property="BackgroundColor"
                    Value="#386BDF" />

                <Setter
                    Property="TextColor"
                    Value="White" />

                <Setter
                    Property="FontSize"
                    Value="17" />

                <Setter
                    Property="FontAttributes"
                    Value="Bold" />

                <Setter
                    Property="CornerRadius"
                    Value="15" />

                <Setter
                    Property="HeightRequest"
                    Value="56" />

            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- CONTEUDO PRINCIPAL -->
    <ScrollView>

        <VerticalStackLayout
            Padding="22,35,22,25"
            Spacing="22"
            MaximumWidthRequest="460">

            <!-- CABECALHO -->
            <VerticalStackLayout Spacing="5">

                <Label
                    Text="ETEC - MOBILE I"
                    TextColor="#65E4EF"
                    FontSize="12"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="JOGO DA VELHA"
                    TextColor="White"
                    FontSize="29"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="NEON EDITION"
                    TextColor="#A8B9D9"
                    FontSize="13"
                    CharacterSpacing="4"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- PLACAR -->
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="9">

                <!-- JOGADOR X -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#203453"
                    Stroke="#405A80"
                    StrokeThickness="1"
                    Padding="8,14"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="JOGADOR X"
                            TextColor="#65E4EF"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="lblPlacarX"
                            Text="0"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- EMPATES -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#203453"
                    Stroke="#405A80"
                    StrokeThickness="1"
                    Padding="8,14"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="EMPATES"
                            TextColor="#A8B9D9"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="lblEmpates"
                            Text="0"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- JOGADOR O -->
                <Border
                    Grid.Column="2"
                    BackgroundColor="#203453"
                    Stroke="#405A80"
                    StrokeThickness="1"
                    Padding="8,14"
                    StrokeShape="RoundRectangle 14">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="JOGADOR O"
                            TextColor="#FFB47B"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="lblPlacarO"
                            Text="0"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- INDICADOR DA VEZ -->
            <Border
                BackgroundColor="#203453"
                Stroke="#405A80"
                StrokeShape="RoundRectangle 30"
                Padding="14">

                <Label
                    x:Name="lblStatus"
                    Text="Vez do jogador X"
                    TextColor="#65E4EF"
                    FontSize="17"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

            </Border>

            <!-- TABULEIRO 3 X 3 -->
            <Grid
                x:Name="Tabuleiro"
                RowDefinitions="*,*,*"
                ColumnDefinitions="*,*,*"
                RowSpacing="9"
                ColumnSpacing="9"
                HeightRequest="330"
                MaximumWidthRequest="380"
                HorizontalOptions="Fill">

                <!-- PRIMEIRA LINHA -->
                <Button
                    x:Name="btn00"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <Button
                    x:Name="btn01"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <Button
                    x:Name="btn02"
                    Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <!-- SEGUNDA LINHA -->
                <Button
                    x:Name="btn10"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <Button
                    x:Name="btn11"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <Button
                    x:Name="btn12"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <!-- TERCEIRA LINHA -->
                <Button
                    x:Name="btn20"
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <Button
                    x:Name="btn21"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

                <Button
                    x:Name="btn22"
                    Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource CasaStyle}"
                    Clicked="Button_Clicked" />

            </Grid>

            <!-- RESULTADO DA PARTIDA -->
            <Label
                x:Name="lblResultado"
                Text=""
                TextColor="#F7D46A"
                FontSize="19"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                MinimumHeightRequest="28" />

            <!-- NOVA PARTIDA -->
            <Button
                x:Name="btnReiniciar"
                Text="NOVA PARTIDA"
                Style="{StaticResource AcaoStyle}"
                Clicked="Reiniciar_Clicked" />

            <!-- RODAPE -->
            <Label
                Text="Desenvolvido para a Agenda 11 - ETEC"
                TextColor="#8FA4C8"
                FontSize="11"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
